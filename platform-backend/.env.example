PORT=3000
SESSION_SECRET=change-this-to-a-random-string
CRYPTO_SECRET=change-this-to-a-random-string
# iOS App JWT：至少 32 个字符；Platform 与 Exhibition 必须配置为同一值
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters
DB_PATH=../data/LIC_DB.db
SESSION_DB_PATH=../data/sessions.db
FRONTEND_URL=http://localhost:5174
NODE_ENV=development

# SSO 配置（子系统验证时需要与此一致）
SSO_SECRET=change-this-to-a-random-string
