# ============================================================
# 本地开发环境配置（复制此文件为 .env，用于本地测试）
# cp .env.development.example .env
# ============================================================

# 服务器配置
PORT=3000
FRONTEND_URL=http://localhost:5174

# 子系统本地地址（用于 SSO 跳转，生产环境改为对应域名）
EXHIBITION_URL=http://localhost:5173
INVENTORY_URL=http://localhost:5175

# 数据库路径（本地路径，相对于 platform-backend 目录）
# 建议指向同一个本地数据库文件，方便与其他系统共享数据
DB_PATH=../data/database/LIC_DB.db
SESSION_DB_PATH=../data/platform-sessions.db

# Session 密钥（本地开发用，可随意填写）
SESSION_SECRET=dev-platform-secret-change-me
# iOS App JWT：Platform 与 Exhibition 本地环境必须使用同一值，至少 32 字符
JWT_SECRET=dev-ios-jwt-secret-change-me-at-least-32-characters

NODE_ENV=development
